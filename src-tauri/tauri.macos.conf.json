{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipiccolo",
        "width": 380,
        "height": 544,
        "minWidth": 340,
        "minHeight": 464,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "Video",
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "resources/ffmpeg.exe": null
    },
    "fileAssociations": [
      {
        "name": "Video",
        "ext": ["mp4", "mov", "m4v", "mkv", "avi", "webm", "wmv", "flv", "mpg", "mpeg", "ts", "mts", "m2ts", "3gp", "gif", "ogv"],
        "contentTypes": ["public.movie", "public.audiovisual-content"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
