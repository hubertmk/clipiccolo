{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipiccolo",
  "version": "0.5.0",
  "identifier": "io.github.hubertmk.clipiccolo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clipiccolo",
        "width": 380,
        "height": 520,
        "minWidth": 340,
        "minHeight": 440,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Clipiccolo",
    "copyright": "Copyright (c) 2026 Hubert Maria Kerschbaum. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/hubertmk/clipiccolo",
    "shortDescription": "Shrink any video to a small MP4",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ffmpeg.exe": "ffmpeg.exe",
      "resources/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../THIRD-PARTY-LICENSES.html": "THIRD-PARTY-LICENSES.html"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "mainBinaryName": "Clipiccolo"
}
